<?xml version="1.0"?>
<?xml-model href="http://download.ros.org/schema/package_format3.xsd" schematypens="http://www.w3.org/2001/XMLSchema"?>
<package format="3">
  <name>racerbot_imu</name>
  <version>0.1.0</version>
  <description>IMU conditioning (SI units, base_link axes, gyro bias) and the two-IMU cross-check. Publishes nothing that can move the car.</description>
  <maintainer email="bryanmaubc@gmail.com">racerbotcar-1</maintainer>
  <license>MIT</license>

  <depend>rclpy</depend>
  <depend>sensor_msgs</depend>
  <depend>nav_msgs</depend>
  <depend>std_msgs</depend>
  <exec_depend>python3-numpy</exec_depend>

  <test_depend>python3-pytest</test_depend>

  <export>
    <build_type>ament_python</build_type>
  </export>
</package>
