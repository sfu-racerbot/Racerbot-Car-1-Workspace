<?xml version="1.0"?>
<package format="3">
  <name>opponent_perception</name>
  <version>0.1.0</version>
  <description>Observe tagged opponents, compensate ego motion and predict short trajectories. Support code only.</description>
  <maintainer email="contact@sfuracerbot.ca">SFU Racerbot</maintainer>
  <license>MIT</license>
  <buildtool_depend>python3-setuptools</buildtool_depend>
  <exec_depend>rclpy</exec_depend>
  <exec_depend>sensor_msgs</exec_depend>
  <exec_depend>std_msgs</exec_depend>
  <exec_depend>geometry_msgs</exec_depend>
  <exec_depend>visualization_msgs</exec_depend>
  <exec_depend>tf2_ros</exec_depend>
  <exec_depend>cv_bridge</exec_depend>
  <exec_depend>python3-numpy</exec_depend>
  <exec_depend>python3-opencv</exec_depend>
  <exec_depend>python3-yaml</exec_depend>
  <exec_depend>ament_index_python</exec_depend>
  <exec_depend>launch</exec_depend>
  <exec_depend>launch_ros</exec_depend>
  <test_depend>python3-pytest</test_depend>
  <test_depend>rosgraph_msgs</test_depend>
  <export><build_type>ament_python</build_type></export>
</package>
